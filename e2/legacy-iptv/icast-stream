#!/bin/sh
#
# iCast DTMB/DVBC dongle -> one UDP stream per program on localhost
#
# The dongle is driven from userspace over libusb, so there is no kernel
# module to load: this script just keeps one streaming process running.
#
# Why one port per program instead of the whole multiplex: the transponder
# carries every service at once (about 38 Mbit/s here). A settop box demuxer
# fed that over UDP has to buffer for the peak rate and stalls before it
# prerolls, so each channel gets its own program with a rewritten PAT.
# Enigma2 picks them up as 4097 services (see /etc/enigma2/userbouquet.icast.tv).
#
### BEGIN INIT INFO
# Provides:          icast-stream
# Required-Start:    $network
# Default-Start:     S
# Short-Description: iCast DVB-C/T streamer
### END INIT INFO

DAEMON=/usr/bin/icast-libusb
PIDFILE=/var/run/icast-stream.pid
LOGFILE=/tmp/icast-stream.log

# Cable: 251 MHz, 6875 kSym/s, QAM64. Change these to match your feed.
FREQ=251
SYMBOLRATE=6875
QAM=64

# Program numbers as they appear in the PAT, one port each, in this order.
# "icast-libusb scan" (or the PAT listing in the log) shows them.
PROGRAMS="220 221 222 223 229"
BASE_PORT=5001

is_running() {
	[ -f "$PIDFILE" ] || return 1
	kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
	if is_running; then
		echo "icast-stream already running (pid $(cat "$PIDFILE"))"
		return 0
	fi
	if [ ! -x "$DAEMON" ]; then
		echo "icast-stream: $DAEMON is missing"
		return 1
	fi

	args=""
	port=$BASE_PORT
	for p in $PROGRAMS; do
		args="$args -p $p=udp://127.0.0.1:$port"
		port=$((port + 1))
	done

	: > "$LOGFILE"
	setsid "$DAEMON" -C -f "$FREQ" -r "$SYMBOLRATE" -m "$QAM" -q \
		stream $args >> "$LOGFILE" 2>&1 < /dev/null &
	echo $! > "$PIDFILE"
	echo "icast-stream started (pid $!), ports $BASE_PORT..$((port - 1))"
}

stop() {
	if ! is_running; then
		echo "icast-stream not running"
		rm -f "$PIDFILE"
		return 0
	fi
	kill "$(cat "$PIDFILE")" 2>/dev/null
	i=0
	while is_running && [ $i -lt 20 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	is_running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	echo "icast-stream stopped"
}

status() {
	if is_running; then
		echo "icast-stream running (pid $(cat "$PIDFILE"))"
		grep -a -E '^(lock:|hb )' "$LOGFILE" | tail -2
	else
		echo "icast-stream not running"
		return 3
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	status)  status ;;
	*)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
